<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WalkNWash.VRCompanion</AssemblyName>
    <Version>0.3.2</Version>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildProjectDirectory)/..</GameDir>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SmokeTest)' == 'true'">
    <DefineConstants>$(DefineConstants);VR_COMPANION_SMOKE_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(SmokeTest)' == 'true'">
    <Compile Include="tests/RuntimeSmoke.cs" />
    <Compile Include="tests/RuntimeDialogueSmoke.cs" />
    <Compile Include="tests/RuntimeHudSmoke.cs" />
    <Reference Include="$(GameDir)/DragNWash_Data/Managed/UnityEngine.ImageConversionModule.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Reference Include="$(GameDir)/DragNWash_Data/Managed/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(GameDir)/DragNWash_Data/Managed/UnityEngine.dll" Private="false" />
    <Reference Include="$(GameDir)/DragNWash_Data/Managed/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameDir)/DragNWash_Data/Managed/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(GameDir)/DragNWash_Data/Managed/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(GameDir)/DragNWash_Data/Managed/Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(GameDir)/DragNWash_Data/Managed/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(GameDir)/DragNWash_Data/Managed/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(GameDir)/DragNWash_Data/Managed/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(GameDir)/DragNWash_Data/Managed/YarnSpinner.Unity.dll" Private="false" />
    <Reference Include="$(GameDir)/DragNWash_Data/Managed/YarnSpinner.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.Unity.Mono.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/0Harmony.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameDir)/DragNWash_Data/Managed/Assembly-CSharp.dll')"
           Text="Set GameDir to the game installation containing DragNWash_Data and BepInEx." />
  </Target>
</Project>
